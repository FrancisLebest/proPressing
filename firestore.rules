rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HARDENED PRIMITIVE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Optional custom-claim role enforcement:
    // - Non-financial operational roles (OPERATEUR, CONTROLE_QUALITE, LIVREUR) cannot read salaries/accounting
    //   nor mutate financial order fields, tariffs, or agency settings.
    // - Only DIRECTEUR / GERANT_AGENCE (or owner session without restricted role claim) can modify tariffs & agency settings.
    // - CAISSIER may run cash closing (Z) and update local thermal printer preferences only.
    function hasRoleClaim() {
      return isSignedIn() && ('role' in request.auth.token) && request.auth.token.role is string;
    }

    function isNonFinancialRole() {
      return hasRoleClaim() && request.auth.token.role in ['OPERATEUR', 'CONTROLE_QUALITE', 'LIVREUR'];
    }

    function isAgencyAdminRole() {
      return !hasRoleClaim() || request.auth.token.role in ['DIRECTEUR', 'GERANT_AGENCE'];
    }

    function isDirectorRole() {
      return !hasRoleClaim() || request.auth.token.role == 'DIRECTEUR';
    }

    function isCashierRole() {
      return hasRoleClaim() && request.auth.token.role == 'CAISSIER';
    }

    // Anti-privilege escalation: only DIRECTEUR can assign/manage DIRECTEUR or GERANT_AGENCE.
    // GERANT_AGENCE may only assign/manage operational agency staff roles below their own level.
    function canAssignEmployeeRole(targetRole) {
      return isDirectorRole() ||
        (isAgencyAdminRole() && targetRole in ['CAISSIER', 'OPERATEUR', 'CONTROLE_QUALITE', 'LIVREUR']);
    }

    function canManageExistingEmployee(existingRole) {
      return isDirectorRole() ||
        (isAgencyAdminRole() && existingRole in ['CAISSIER', 'OPERATEUR', 'CONTROLE_QUALITE', 'LIVREUR']);
    }

    function hasAgencyClaim() {
      return isSignedIn() && ('agency' in request.auth.token) &&
        request.auth.token.agency is string &&
        request.auth.token.agency.size() > 0;
    }

    // Strict server-side cross-agency isolation: when a staff token carries an agency claim,
    // only DIRECTEUR can cross agencies; all agency-scoped roles are restricted to their exact agency.
    function matchesAgencyClaim(docAgency) {
      return isDirectorRole() || !hasAgencyClaim() || docAgency == request.auth.token.agency;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isOptString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidPaymentMethod(method) {
      return method is string && method in [
        'ESPECES', 'ORANGE_MONEY', 'MTN_MOMO', 'WAVE', 'MOOV_MONEY', 'CARTE', 'VIREMENT'
      ];
    }

    function isValidOrderStatus(status) {
      return status is string && status in [
        'PENDING', 'ACCEPTED', 'WASHING', 'DRYING', 'IRONING',
        'FINISHING', 'QUALITY_CHECK', 'READY', 'PICKED_UP', 'DELIVERED', 'CANCELLED'
      ];
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---

    function isValidCompanyConfig(data, userId) {
      return data.userId == userId &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120 &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10 &&
        data.orderPrefix is string && data.orderPrefix.size() >= 1 && data.orderPrefix.size() <= 20 &&
        data.receiptFormat in ['THERMAL_58', 'THERMAL_80', 'A4_PDF'] &&
        data.subscriptionPlan in ['STARTER', 'BUSINESS', 'ENTERPRISE'] &&
        data.subscriptionBilling in ['MONTHLY', 'QUARTERLY', 'ANNUAL'] &&
        data.subscriptionStatus in ['TRIAL', 'ACTIVE', 'GRACE', 'SUSPENDED'] &&
        data.setupStep is int && data.setupStep >= 1 && data.setupStep <= 10 &&
        data.setupCompleted is bool &&
        (!('maxCashierDiscountPercent' in data) || (data.maxCashierDiscountPercent is number && data.maxCashierDiscountPercent >= 0 && data.maxCashierDiscountPercent <= 100)) &&
        (!('corporateDiscountPercent' in data) || (data.corporateDiscountPercent is number && data.corporateDiscountPercent >= 0 && data.corporateDiscountPercent <= 100)) &&
        (!('expressSurchargePercent' in data) || (data.expressSurchargePercent is number && data.expressSurchargePercent >= 0 && data.expressSurchargePercent <= 200)) &&
        (!('ultraExpressSurchargePercent' in data) || (data.ultraExpressSurchargePercent is number && data.ultraExpressSurchargePercent >= 0 && data.ultraExpressSurchargePercent <= 300)) &&
        (!('autoCutPaper' in data) || data.autoCutPaper is bool) &&
        (!('autoPrintLabelsOnPayment' in data) || data.autoPrintLabelsOnPayment is bool) &&
        (!('defaultPrinterName' in data) || (data.defaultPrinterName is string && data.defaultPrinterName.size() <= 100)) &&
        (!('defaultPrinterAddress' in data) || (data.defaultPrinterAddress is string && data.defaultPrinterAddress.size() <= 40)) &&
        (!('lastCashCloseDate' in data) || (data.lastCashCloseDate is string && data.lastCashCloseDate.size() <= 20)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidServiceItem(data, userId) {
      return data.userId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
        data.treatmentType is string && data.treatmentType.size() >= 1 && data.treatmentType.size() <= 60 &&
        data.billingUnit is string && data.billingUnit in ['PIECE', 'KG', 'SQM'] &&
        data.unitPrice is int && data.unitPrice >= 0 && data.unitPrice <= 10000000 &&
        data.expressPrice is int && data.expressPrice >= 0 && data.expressPrice <= 10000000 &&
        data.delayHours is int && data.delayHours >= 1 && data.delayHours <= 720 &&
        data.available is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidClientRecord(data, userId) {
      return data.userId == userId &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 30 &&
        isOptString(data, 'whatsapp', 30) &&
        isOptString(data, 'email', 120) &&
        data.category is string && data.category in ['PARTICULIER', 'VIP', 'ENTREPRISE', 'HOTEL', 'RESTAURANT'] &&
        isOptString(data, 'address', 250) &&
        (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
        (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
        data.loyaltyPoints is int && data.loyaltyPoints >= 0 && data.loyaltyPoints <= 10000000 &&
        data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100 &&
        data.creditLimit is int && data.creditLimit >= 0 && data.creditLimit <= 100000000 &&
        data.balanceDue is int && data.balanceDue >= -100000000 && data.balanceDue <= 100000000 &&
        isOptString(data, 'preferences', 300) &&
        isOptString(data, 'notes', 500) &&
        data.active is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidPressingOrder(data, userId) {
      return data.userId == userId &&
        data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 40 &&
        isOptString(data, 'trackingToken', 32) &&
        isOptString(data, 'agencyName', 100) &&
        isOptString(data, 'clientId', 128) &&
        data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120 &&
        isOptString(data, 'clientPhone', 30) &&
        isOptString(data, 'clientAddress', 250) &&
        isValidOrderStatus(data.status) &&
        data.priority is string && data.priority in ['ECONOMY', 'STANDARD', 'EXPRESS'] &&
        data.items is list && data.items.size() <= 50 && (data.items.size() == 0 || data.items[0] is map) &&
        data.itemCount is int && data.itemCount >= 0 && data.itemCount <= 1000 &&
        data.subtotal is int && data.subtotal >= 0 && data.subtotal <= 100000000 &&
        data.discountAmount is int && data.discountAmount >= 0 && data.discountAmount <= 100000000 &&
        data.expressFee is int && data.expressFee >= 0 && data.expressFee <= 100000000 &&
        data.deliveryFee is int && data.deliveryFee >= 0 && data.deliveryFee <= 100000000 &&
        data.taxAmount is int && data.taxAmount >= 0 && data.taxAmount <= 100000000 &&
        data.totalAmount is int && data.totalAmount >= 0 && data.totalAmount <= 100000000 &&
        data.paidAmount is int && data.paidAmount >= 0 && data.paidAmount <= 100000000 &&
        data.remainingAmount is int && data.remainingAmount >= 0 && data.remainingAmount <= 100000000 &&
        data.paymentStatus is string && data.paymentStatus in ['UNPAID', 'PARTIAL', 'PAID'] &&
        isValidPaymentMethod(data.paymentMethod) &&
        data.deliveryRequested is bool &&
        isOptString(data, 'deliveryDriver', 100) &&
        isOptString(data, 'deliveryZone', 100) &&
        isOptString(data, 'assignedEmployee', 100) &&
        data.qualityChecked is bool &&
        isOptString(data, 'clientSignatureName', 120) &&
        isOptString(data, 'observations', 500) &&
        data.dueDateMillis is int && data.dueDateMillis >= 0 &&
        data.statusHistory is list && data.statusHistory.size() <= 30 && (data.statusHistory.size() == 0 || data.statusHistory[0] is string) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAccountingEntry(data, userId) {
      return data.userId == userId &&
        data.reference is string && data.reference.size() >= 1 && data.reference.size() <= 60 &&
        data.entryType is string && data.entryType in ['REVENUE', 'EXPENSE', 'CASH_OPEN', 'CASH_CLOSE', 'REFUND'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.syscohadaAccount is string && data.syscohadaAccount.size() >= 1 && data.syscohadaAccount.size() <= 20 &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 200 &&
        data.amount is int && data.amount >= 0 && data.amount <= 100000000 &&
        isValidPaymentMethod(data.paymentMethod) &&
        isOptString(data, 'orderId', 128) &&
        isOptString(data, 'counterparty', 120) &&
        isOptString(data, 'agencyName', 100) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidStockItem(data, userId) {
      return data.userId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.itemKind is string && data.itemKind in ['CONSUMABLE', 'MACHINE'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.quantity is int && data.quantity >= 0 && data.quantity <= 1000000 &&
        data.minThreshold is int && data.minThreshold >= 0 && data.minThreshold <= 1000000 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 30 &&
        data.unitCost is int && data.unitCost >= 0 && data.unitCost <= 100000000 &&
        isOptString(data, 'supplierName', 120) &&
        data.machineStatus is string && data.machineStatus in ['OPERATIONAL', 'MAINTENANCE', 'BREAKDOWN'] &&
        isOptString(data, 'maintenanceNotes', 400) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidEmployeeRecord(data, userId) {
      return data.userId == userId &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        isOptString(data, 'phone', 30) &&
        data.role is string && data.role in ['DIRECTEUR', 'GERANT_AGENCE', 'CAISSIER', 'OPERATEUR', 'CONTROLE_QUALITE', 'LIVREUR'] &&
        isOptString(data, 'agencyName', 100) &&
        data.monthlySalary is int && data.monthlySalary >= 0 && data.monthlySalary <= 100000000 &&
        data.commissionRate is number && data.commissionRate >= 0 && data.commissionRate <= 100 &&
        data.presentToday is bool &&
        data.active is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidClaimRecord(data, userId) {
      return data.userId == userId &&
        isOptString(data, 'orderNumber', 40) &&
        data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 600 &&
        data.severity is string && data.severity in ['LOW', 'MEDIUM', 'HIGH'] &&
        data.status is string && data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'] &&
        isOptString(data, 'resolutionNote', 400) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAuditLogRecord(data, userId) {
      return data.userId == userId &&
        data.actor is string && data.actor.size() >= 1 && data.actor.size() <= 100 &&
        data.roleLabel is string && data.roleLabel.size() >= 1 && data.roleLabel.size() <= 60 &&
        data.scopeLabel is string && data.scopeLabel.size() >= 1 && data.scopeLabel.size() <= 120 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 240 &&
        isOptString(data, 'route', 60) &&
        data.allowed is bool &&
        isValidTimestamp(data.createdAt);
    }

    function isValidFcmTokenRecord(data, userId) {
      return data.userId == userId &&
        data.token is string && data.token.size() >= 10 && data.token.size() <= 300 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 40 &&
        isOptString(data, 'agencyName', 100) &&
        data.topics is list && data.topics.size() <= 15 &&
        data.platform is string && data.platform in ['ANDROID', 'IOS', 'WEB'] &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidPushNotificationRecord(data, userId) {
      return data.userId == userId &&
        data.eventType is string && data.eventType in ['NEW_ORDER_CASHIER', 'ORDER_READY_CLIENT', 'OFFLINE_SYNCED'] &&
        data.targetRole is string && data.targetRole.size() >= 1 && data.targetRole.size() <= 40 &&
        isOptString(data, 'agencyName', 100) &&
        isOptString(data, 'orderNumber', 40) &&
        isOptString(data, 'clientPhone', 30) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 300 &&
        data.delivered is bool &&
        isValidTimestamp(data.createdAt);
    }

    // --- MULTI-TENANT COMPANY ROOT & SUBCOLLECTIONS ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isAgencyAdminRole() &&
        isValidId(userId) &&
        incoming().keys().hasAll([
          'userId', 'companyName', 'currency', 'orderPrefix', 'receiptFormat',
          'subscriptionPlan', 'subscriptionBilling', 'subscriptionStatus',
          'setupStep', 'setupCompleted', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'companyName', 'legalName', 'rccm', 'nif', 'description',
          'phone', 'whatsapp', 'email', 'country', 'city', 'commune', 'address',
          'latitude', 'longitude', 'currency', 'taxRatePercent', 'openingHours',
          'standardDelayHours', 'expressDelayHours', 'expressSurchargePercent',
          'ultraExpressDelayHours', 'ultraExpressSurchargePercent',
          'maxCashierDiscountPercent', 'corporateDiscountPercent',
          'orderPrefix', 'receiptFooter', 'receiptFormat',
          'autoCutPaper', 'autoPrintLabelsOnPayment', 'defaultPrinterName', 'defaultPrinterAddress',
          'lastCashCloseDate', 'acceptedPayments',
          'agencies', 'smsNotificationsEnabled', 'whatsappNotificationsEnabled',
          'subscriptionPlan', 'subscriptionBilling', 'subscriptionStatus',
          'setupStep', 'setupCompleted', 'createdAt', 'updatedAt'
        ]) &&
        isValidCompanyConfig(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          (isAgencyAdminRole() &&
            request.resource.data.keys().hasOnly([
              'userId', 'companyName', 'legalName', 'rccm', 'nif', 'description',
              'phone', 'whatsapp', 'email', 'country', 'city', 'commune', 'address',
              'latitude', 'longitude', 'currency', 'taxRatePercent', 'openingHours',
              'standardDelayHours', 'expressDelayHours', 'expressSurchargePercent',
              'ultraExpressDelayHours', 'ultraExpressSurchargePercent',
              'maxCashierDiscountPercent', 'corporateDiscountPercent',
              'orderPrefix', 'receiptFooter', 'receiptFormat',
              'autoCutPaper', 'autoPrintLabelsOnPayment', 'defaultPrinterName', 'defaultPrinterAddress',
              'lastCashCloseDate', 'acceptedPayments',
              'agencies', 'smsNotificationsEnabled', 'whatsappNotificationsEnabled',
              'subscriptionPlan', 'subscriptionBilling', 'subscriptionStatus',
              'setupStep', 'setupCompleted', 'createdAt', 'updatedAt'
            ])) ||
          (isCashierRole() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'receiptFormat', 'autoCutPaper', 'autoPrintLabelsOnPayment',
              'defaultPrinterName', 'defaultPrinterAddress', 'lastCashCloseDate', 'updatedAt'
            ]))
        ) &&
        isValidCompanyConfig(request.resource.data, userId);

      allow delete: if false;

      // Services & Tarifs (Modification réservée Directeur Général & Gérant d'Agence)
      match /services/{serviceId} {
        allow get: if isOwner(userId) && isValidId(serviceId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isAgencyAdminRole() &&
          isValidId(serviceId) &&
          incoming().keys().hasAll([
            'userId', 'name', 'category', 'treatmentType', 'billingUnit',
            'unitPrice', 'expressPrice', 'delayHours', 'available', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'name', 'category', 'treatmentType', 'billingUnit',
            'unitPrice', 'expressPrice', 'delayHours', 'available', 'createdAt', 'updatedAt'
          ]) &&
          isValidServiceItem(incoming(), userId);

        allow update: if isOwner(userId) &&
          isAgencyAdminRole() &&
          isValidId(serviceId) &&
          isValidServiceItem(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'category', 'treatmentType', 'billingUnit',
            'unitPrice', 'expressPrice', 'delayHours', 'available', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isAgencyAdminRole() && isValidId(serviceId);
      }

      // Clients CRM
      match /clients/{clientId} {
        allow get: if isOwner(userId) && isValidId(clientId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          !isNonFinancialRole() &&
          isValidId(clientId) &&
          incoming().keys().hasAll([
            'userId', 'fullName', 'phone', 'category', 'loyaltyPoints',
            'discountPercent', 'creditLimit', 'balanceDue', 'active', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'fullName', 'phone', 'whatsapp', 'email', 'category',
            'address', 'latitude', 'longitude', 'loyaltyPoints', 'discountPercent',
            'creditLimit', 'balanceDue', 'preferences', 'notes', 'active', 'createdAt', 'updatedAt'
          ]) &&
          isValidClientRecord(incoming(), userId);

        allow update: if isOwner(userId) &&
          !isNonFinancialRole() &&
          isValidId(clientId) &&
          isValidClientRecord(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'phone', 'whatsapp', 'email', 'category',
            'address', 'latitude', 'longitude', 'loyaltyPoints', 'discountPercent',
            'creditLimit', 'balanceDue', 'preferences', 'notes', 'active', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isAgencyAdminRole() && isValidId(clientId);
      }

      // Commandes & Production (isolation stricte par tenant ET par agence côté serveur)
      match /orders/{orderId} {
        allow get: if isOwner(userId) && isValidId(orderId) && matchesAgencyClaim(existing().agencyName);
        allow list: if isOwner(userId) && matchesAgencyClaim(resource.data.agencyName);

        allow create: if isOwner(userId) &&
          !isNonFinancialRole() &&
          isValidId(orderId) &&
          matchesAgencyClaim(incoming().agencyName) &&
          incoming().keys().hasAll([
            'userId', 'orderNumber', 'clientName', 'status', 'priority', 'items',
            'itemCount', 'subtotal', 'discountAmount', 'expressFee', 'deliveryFee',
            'taxAmount', 'totalAmount', 'paidAmount', 'remainingAmount',
            'paymentStatus', 'paymentMethod', 'deliveryRequested', 'qualityChecked',
            'dueDateMillis', 'statusHistory', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'orderNumber', 'trackingToken', 'agencyName', 'clientId', 'clientName', 'clientPhone',
            'clientAddress', 'status', 'priority', 'items', 'itemCount', 'subtotal',
            'discountAmount', 'expressFee', 'deliveryFee', 'taxAmount', 'totalAmount',
            'paidAmount', 'remainingAmount', 'paymentStatus', 'paymentMethod',
            'deliveryRequested', 'deliveryDriver', 'deliveryZone', 'assignedEmployee',
            'qualityChecked', 'clientSignatureName', 'observations', 'dueDateMillis',
            'statusHistory', 'createdAt', 'updatedAt'
          ]) &&
          isValidPressingOrder(incoming(), userId);

        allow update: if isOwner(userId) &&
          isValidId(orderId) &&
          resource.data.status != 'CANCELLED' &&
          matchesAgencyClaim(resource.data.agencyName) &&
          matchesAgencyClaim(request.resource.data.agencyName) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.orderNumber == resource.data.orderNumber &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (
            // Action 1: Production workflow, per-item workshop tracking & quality update (financial fields guaranteed untouched by affectedKeys)
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'items', 'assignedEmployee', 'qualityChecked', 'statusHistory', 'observations', 'updatedAt'
            ]) ||
            // Action 2: Payment settlement update (interdit aux rôles Opérateur, Contrôle Qualité et Livreur)
            (!isNonFinancialRole() &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'paidAmount', 'remainingAmount', 'paymentStatus', 'paymentMethod', 'statusHistory', 'updatedAt'
              ])) ||
            // Action 3: Delivery assignment & dispatch update (financial fields guaranteed untouched by affectedKeys)
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'deliveryRequested', 'deliveryDriver', 'deliveryZone', 'status', 'statusHistory', 'updatedAt'
            ])
          ) &&
          isValidPressingOrder(request.resource.data, userId);

        allow delete: if false;
      }

      // Caisse & Comptabilité SYSCOHADA (audit trail immutable: interdit aux rôles non financiers + isolé par agence)
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && !isNonFinancialRole() && isValidId(transactionId) && matchesAgencyClaim(existing().agencyName);
        allow list: if isOwner(userId) && !isNonFinancialRole() && matchesAgencyClaim(resource.data.agencyName);

        allow create: if isOwner(userId) &&
          !isNonFinancialRole() &&
          isValidId(transactionId) &&
          matchesAgencyClaim(incoming().agencyName) &&
          incoming().keys().hasAll([
            'userId', 'reference', 'entryType', 'category', 'syscohadaAccount',
            'label', 'amount', 'paymentMethod', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'reference', 'entryType', 'category', 'syscohadaAccount',
            'label', 'amount', 'paymentMethod', 'orderId', 'counterparty',
            'agencyName', 'createdAt', 'updatedAt'
          ]) &&
          isValidAccountingEntry(incoming(), userId);

        allow update: if false;
        allow delete: if false;
      }

      // Stocks & Machines
      match /stocks/{stockId} {
        allow get: if isOwner(userId) && isValidId(stockId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(stockId) &&
          incoming().keys().hasAll([
            'userId', 'name', 'itemKind', 'category', 'quantity', 'minThreshold',
            'unit', 'unitCost', 'machineStatus', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'name', 'itemKind', 'category', 'quantity', 'minThreshold',
            'unit', 'unitCost', 'supplierName', 'machineStatus', 'maintenanceNotes',
            'createdAt', 'updatedAt'
          ]) &&
          isValidStockItem(incoming(), userId);

        allow update: if isOwner(userId) &&
          isValidId(stockId) &&
          isValidStockItem(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'itemKind', 'category', 'quantity', 'minThreshold',
            'unit', 'unitCost', 'supplierName', 'machineStatus', 'maintenanceNotes', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isAgencyAdminRole() && isValidId(stockId);
      }

      // Employés, Salaires & Présences (interdit aux rôles Opérateur, Contrôle Qualité, Livreur ET Caissier + anti-escalade)
      match /employees/{employeeId} {
        allow get: if isOwner(userId) && !isNonFinancialRole() && !isCashierRole() && isValidId(employeeId) && matchesAgencyClaim(existing().agencyName);
        allow list: if isOwner(userId) && !isNonFinancialRole() && !isCashierRole() && matchesAgencyClaim(resource.data.agencyName);

        allow create: if isOwner(userId) &&
          isAgencyAdminRole() &&
          isValidId(employeeId) &&
          matchesAgencyClaim(incoming().agencyName) &&
          canAssignEmployeeRole(incoming().role) &&
          incoming().keys().hasAll([
            'userId', 'fullName', 'role', 'monthlySalary', 'commissionRate',
            'presentToday', 'active', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'fullName', 'phone', 'role', 'agencyName', 'monthlySalary',
            'commissionRate', 'presentToday', 'active', 'createdAt', 'updatedAt'
          ]) &&
          isValidEmployeeRecord(incoming(), userId);

        allow update: if isOwner(userId) &&
          isAgencyAdminRole() &&
          isValidId(employeeId) &&
          matchesAgencyClaim(existing().agencyName) &&
          matchesAgencyClaim(incoming().agencyName) &&
          canManageExistingEmployee(existing().role) &&
          canAssignEmployeeRole(incoming().role) &&
          isValidEmployeeRecord(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'phone', 'role', 'agencyName', 'monthlySalary',
            'commissionRate', 'presentToday', 'active', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) &&
          isAgencyAdminRole() &&
          isValidId(employeeId) &&
          matchesAgencyClaim(existing().agencyName) &&
          canManageExistingEmployee(existing().role);
      }

      // Réclamations & Tickets Qualité
      match /claims/{claimId} {
        allow get: if isOwner(userId) && isValidId(claimId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(claimId) &&
          incoming().keys().hasAll([
            'userId', 'clientName', 'subject', 'description', 'severity',
            'status', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'orderNumber', 'clientName', 'subject', 'description',
            'severity', 'status', 'resolutionNote', 'createdAt', 'updatedAt'
          ]) &&
          isValidClaimRecord(incoming(), userId);

        allow update: if isOwner(userId) &&
          isValidId(claimId) &&
          isValidClaimRecord(incoming(), userId) &&
          existing().status != 'RESOLVED' &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'severity', 'resolutionNote', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isAgencyAdminRole() && isValidId(claimId);
      }

      // Journal d'Audit Sécurité & Accès RBAC (création autorisée pour tracer les refus, lecture réservée Directeur, immuable)
      match /audit_logs/{logId} {
        allow get: if isOwner(userId) && isDirectorRole() && isValidId(logId);
        allow list: if isOwner(userId) && isDirectorRole();

        allow create: if isOwner(userId) &&
          isValidId(logId) &&
          incoming().keys().hasAll([
            'userId', 'actor', 'roleLabel', 'scopeLabel', 'action', 'allowed', 'createdAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'actor', 'roleLabel', 'scopeLabel', 'action', 'route', 'allowed', 'createdAt'
          ]) &&
          isValidAuditLogRecord(incoming(), userId);

        allow update: if false;
        allow delete: if false;
      }

      // Jetons Firebase Cloud Messaging (FCM) par appareil authentifié
      match /fcm_tokens/{tokenId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          isValidId(tokenId) &&
          incoming().keys().hasAll([
            'userId', 'token', 'role', 'topics', 'platform', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'token', 'role', 'agencyName', 'topics', 'platform', 'createdAt', 'updatedAt'
          ]) &&
          isValidFcmTokenRecord(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(tokenId);
      }

      // File de notifications FCM (nouvelles commandes caissiers & disponibilité vêtements clients)
      match /notifications/{notifId} {
        allow get: if isOwner(userId) && isValidId(notifId) && matchesAgencyClaim(existing().agencyName);
        allow list: if isOwner(userId) && matchesAgencyClaim(resource.data.agencyName);

        allow create: if isOwner(userId) &&
          isValidId(notifId) &&
          matchesAgencyClaim(incoming().agencyName) &&
          incoming().keys().hasAll([
            'userId', 'eventType', 'targetRole', 'title', 'body', 'delivered', 'createdAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'eventType', 'targetRole', 'agencyName', 'orderNumber',
            'clientPhone', 'title', 'body', 'delivered', 'createdAt'
          ]) &&
          isValidPushNotificationRecord(incoming(), userId);

        allow update: if false;
        allow delete: if false;
      }

      // Politiques d'accès personnalisées & plafonds financiers par gestionnaire (RBAC+ABAC)
      match /manager_policies/{policyId} {
        allow get: if isOwner(userId) && isValidId(policyId);
        allow list: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          isDirectorRole() &&
          isValidId(policyId) &&
          incoming().userId == userId &&
          incoming().employeeId is string && incoming().employeeId.size() >= 1 && incoming().employeeId.size() <= 128 &&
          incoming().employeeName is string && incoming().employeeName.size() >= 1 && incoming().employeeName.size() <= 120 &&
          incoming().profileCode in ['RECEPTIONNISTE', 'CAISSIER', 'AGENT_ATELIER', 'GESTIONNAIRE_STOCK', 'LIVREUR', 'POLYVALENT', 'PERSONNALISE'] &&
          incoming().maxDiscountPercent is int && incoming().maxDiscountPercent >= 0 && incoming().maxDiscountPercent <= 30 &&
          incoming().maxRefundFcfa is int && incoming().maxRefundFcfa >= 0 && incoming().maxRefundFcfa <= 100000000 &&
          incoming().maxExpenseFcfa is int && incoming().maxExpenseFcfa >= 0 && incoming().maxExpenseFcfa <= 100000000 &&
          incoming().maxDisbursementFcfa is int && incoming().maxDisbursementFcfa >= 0 && incoming().maxDisbursementFcfa <= 100000000 &&
          incoming().dailyOperationCapFcfa is int && incoming().dailyOperationCapFcfa >= 0 && incoming().dailyOperationCapFcfa <= 500000000 &&
          incoming().accessStartHour is int && incoming().accessStartHour >= 0 && incoming().accessStartHour <= 23 &&
          incoming().accessEndHour is int && incoming().accessEndHour >= 1 && incoming().accessEndHour <= 24 &&
          incoming().active is bool &&
          isValidTimestamp(incoming().updatedAt);

        allow delete: if isOwner(userId) && isDirectorRole() && isValidId(policyId);
      }

      // Demandes de validation administrative pour opérations sensibles (immuables après exécution/rejet)
      match /approval_requests/{requestId} {
        allow get: if isOwner(userId) && isValidId(requestId) && matchesAgencyClaim(existing().agencyName);
        allow list: if isOwner(userId) && matchesAgencyClaim(resource.data.agencyName);

        allow create: if isOwner(userId) &&
          isValidId(requestId) &&
          matchesAgencyClaim(incoming().agencyName) &&
          incoming().userId == userId &&
          incoming().requestedBy is string && incoming().requestedBy.size() >= 1 && incoming().requestedBy.size() <= 100 &&
          incoming().operationType in ['EXCEPTIONAL_DISCOUNT', 'REFUND', 'ORDER_CANCELLATION', 'LARGE_EXPENSE', 'CASH_ADJUSTMENT', 'STOCK_ADJUSTMENT', 'PRICE_OVERRIDE'] &&
          incoming().amountFcfa is int && incoming().amountFcfa >= 0 && incoming().amountFcfa <= 100000000 &&
          incoming().reason is string && incoming().reason.size() >= 1 && incoming().reason.size() <= 300 &&
          incoming().payloadHash is string && incoming().payloadHash.size() >= 8 && incoming().payloadHash.size() <= 64 &&
          incoming().status == 'PENDING' &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt);

        allow update: if isOwner(userId) &&
          isDirectorRole() &&
          isValidId(requestId) &&
          existing().status in ['PENDING', 'APPROVED'] &&
          incoming().userId == existing().userId &&
          incoming().amountFcfa == existing().amountFcfa &&
          incoming().operationType == existing().operationType &&
          incoming().payloadHash == existing().payloadHash &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'reviewedBy', 'reviewNote', 'executedAtMillis', 'updatedAt'
          ]) &&
          incoming().status in ['APPROVED', 'REJECTED', 'EXECUTED', 'EXPIRED', 'CANCELLED'] &&
          isValidTimestamp(incoming().updatedAt);

        allow delete: if false;
      }
    }
  }
}
