# Pressing Pro SaaS — Environment Variables
# Firebase AI Logic & Cloud Firestore use Firebase App Check and google-services.json.
# No client-side Gemini API key is required.
#
# GeniusPay Côte d'Ivoire — Paiement en ligne des réabonnements SaaS
# Configurez les valeurs réelles dans le panneau Secrets d'AI Studio (et Firebase Functions Secrets en production).
GENIUSPAY_API_KEY=GENIUSPAY_API_KEY_PLACEHOLDER
GENIUSPAY_API_SECRET=GENIUSPAY_API_SECRET_PLACEHOLDER
GENIUSPAY_WEBHOOK_SECRET=GENIUSPAY_WEBHOOK_SECRET_PLACEHOLDER
GENIUSPAY_MODE=live
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant

